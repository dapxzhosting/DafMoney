rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Status verifikasi berasal dari token Firebase Auth (tidak bisa dipalsukan klien).
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // Profil pengguna: hanya pemilik.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // Hanya nama yang boleh diubah.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      allow delete: if false;

      // Data keuangan: hanya pemilik DAN email sudah terverifikasi.
      // Validasi field per koleksi ditambahkan di tahap fiturnya.
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid)
          && isVerified()
          && collection in ['categories', 'transactions', 'budgets'];
      }
    }

    // Tolak semua yang tidak disebutkan di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
