rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Status verifikasi berasal dari token Firebase Auth (tidak bisa dipalsukan klien).
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function canUse(uid) {
      return isOwner(uid) && isVerified();
    }

    function validCategory(d) {
      return d.keys().hasOnly(['name', 'type', 'icon', 'color', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.type in ['income', 'expense']
        && d.icon is string && d.icon.size() <= 30
        && d.color is int
        && d.createdAt is timestamp;
    }

    function validTransaction(d) {
      return d.keys().hasOnly(['type', 'amount', 'categoryId', 'note', 'date', 'createdAt'])
        && d.type in ['income', 'expense']
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 60
        && d.note is string && d.note.size() <= 200
        && d.date is timestamp
        && d.createdAt is timestamp;
    }

    function validBudget(d) {
      return d.keys().hasOnly(['categoryId', 'amount', 'month', 'updatedAt'])
        && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 60
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$')
        && d.updatedAt == request.time;
    }

    // Profil pengguna: hanya pemilik.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // Hanya nama dan saldo awal yang boleh diubah.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'initialBalance'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (!('initialBalance' in request.resource.data)
            || (request.resource.data.initialBalance is int
                && request.resource.data.initialBalance >= 0
                && request.resource.data.initialBalance <= 100000000000));

      // Dihapus saat pengguna menghapus akunnya (setelah semua datanya dihapus).
      allow delete: if isOwner(uid);

      // Kategori: tipe tidak boleh diubah setelah dibuat.
      match /categories/{id} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && validCategory(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if canUse(uid)
          && validCategory(request.resource.data)
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /transactions/{id} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && validTransaction(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if canUse(uid)
          && validTransaction(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // Id dokumen anggaran: "<yyyy-MM>_<categoryId>" (satu per kategori per bulan).
      match /budgets/{id} {
        allow read, delete: if canUse(uid);
        allow create, update: if canUse(uid)
          && validBudget(request.resource.data)
          && id == request.resource.data.month + '_' + request.resource.data.categoryId;
      }
    }

    // Tolak semua yang tidak disebutkan di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
