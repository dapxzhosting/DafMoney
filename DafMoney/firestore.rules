rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Status verifikasi berasal dari token Firebase Auth (tidak bisa dipalsukan klien).
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function canUse(uid) {
      return isOwner(uid) && isVerified();
    }

    function validCategory(d) {
      return d.keys().hasOnly(['name', 'type', 'icon', 'color', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.type in ['income', 'expense']
        && d.icon is string && d.icon.size() <= 30
        && d.color is int
        && d.createdAt is timestamp;
    }

    function validTransaction(d) {
      return d.keys().hasOnly(['type', 'amount', 'categoryId', 'note', 'date', 'createdAt', 'walletId', 'recurringId', 'hasReceipt'])
        && d.type in ['income', 'expense']
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 60
        && d.note is string && d.note.size() <= 200
        && d.date is timestamp
        && d.createdAt is timestamp
        && (!('walletId' in d) || (d.walletId is string && d.walletId.size() <= 60))
        && (!('recurringId' in d) || (d.recurringId is string && d.recurringId.size() <= 60))
        && (!('hasReceipt' in d) || d.hasReceipt is bool);
    }

    function validWallet(d) {
      return d.keys().hasOnly(['name', 'icon', 'color', 'initialBalance', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.icon is string && d.icon.size() <= 30
        && d.color is int
        && d.initialBalance is int && d.initialBalance >= 0 && d.initialBalance <= 100000000000
        && d.createdAt is timestamp;
    }

    // Foto struk (JPEG terkompresi) disimpan sebagai bytes, maksimal ~900 KB.
    function validReceipt(d) {
      return d.keys().hasOnly(['data', 'updatedAt'])
        && d.data is bytes && d.data.size() > 0 && d.data.size() <= 900000
        && d.updatedAt == request.time;
    }

    function validBudget(d) {
      return d.keys().hasOnly(['categoryId', 'amount', 'month', 'updatedAt'])
        && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 60
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$')
        && d.updatedAt == request.time;
    }

    function validRecurring(d) {
      return d.keys().hasOnly(['type', 'amount', 'categoryId', 'note', 'walletId', 'frequency', 'startDate', 'nextDate', 'anchorDay', 'active', 'createdAt'])
        && d.type in ['income', 'expense']
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 60
        && d.note is string && d.note.size() <= 200
        && (!('walletId' in d) || (d.walletId is string && d.walletId.size() <= 60))
        && d.frequency in ['daily', 'weekly', 'monthly', 'yearly']
        && d.startDate is timestamp
        && d.nextDate is timestamp
        && d.anchorDay is int && d.anchorDay >= 1 && d.anchorDay <= 31
        && d.active is bool
        && d.createdAt is timestamp;
    }

    function validTransfer(d) {
      return d.keys().hasOnly(['fromWalletId', 'toWalletId', 'amount', 'note', 'date', 'createdAt'])
        && d.fromWalletId is string && d.fromWalletId.size() > 0 && d.fromWalletId.size() <= 60
        && d.toWalletId is string && d.toWalletId.size() > 0 && d.toWalletId.size() <= 60
        && d.fromWalletId != d.toWalletId
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.note is string && d.note.size() <= 200
        && d.date is timestamp
        && d.createdAt is timestamp;
    }

    function validGoal(d) {
      return d.keys().hasOnly(['name', 'icon', 'color', 'target', 'saved', 'deadline', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.icon is string && d.icon.size() <= 30
        && d.color is int
        && d.target is int && d.target > 0 && d.target <= 100000000000
        && d.saved is int && d.saved >= 0 && d.saved <= 100000000000
        && (!('deadline' in d) || d.deadline is timestamp)
        && d.createdAt is timestamp;
    }

    function validDebt(d) {
      return d.keys().hasOnly(['person', 'kind', 'amount', 'paid', 'note', 'date', 'dueDate', 'createdAt'])
        && d.person is string && d.person.size() > 0 && d.person.size() <= 60
        && d.kind in ['owe', 'lend']
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.paid is int && d.paid >= 0 && d.paid <= d.amount
        && d.note is string && d.note.size() <= 200
        && d.date is timestamp
        && (!('dueDate' in d) || d.dueDate is timestamp)
        && d.createdAt is timestamp;
    }

    // Tantangan tanpa jajan: c = id kategori, s = tanggal mulai (ISO), t = target hari, b = rekor terbaik.
    function validChallenge(c) {
      return c is map
        && c.keys().hasOnly(['c', 's', 't', 'b'])
        && c.c is string && c.c.size() <= 60
        && c.s is string && c.s.size() <= 40
        && c.t is int && c.t >= 1 && c.t <= 3650
        && (!('b' in c) || (c.b is int && c.b >= 0 && c.b <= 3650));
    }

    // Profil pengguna: hanya pemilik.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // Nama, saldo awal, tantangan, dan pengaturan kunci aplikasi yang boleh diubah.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'initialBalance', 'challenge', 'appLockEnabled', 'appLockGrace', 'themeMode', 'accentColor', 'amoled'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (!('initialBalance' in request.resource.data)
            || (request.resource.data.initialBalance is int
                && request.resource.data.initialBalance >= 0
                && request.resource.data.initialBalance <= 100000000000))
        && (!('appLockEnabled' in request.resource.data)
            || request.resource.data.appLockEnabled is bool)
        && (!('appLockGrace' in request.resource.data)
            || request.resource.data.appLockGrace in [0, 60, 300])
        && (!('challenge' in request.resource.data)
            || validChallenge(request.resource.data.challenge))
        && (!('themeMode' in request.resource.data)
            || request.resource.data.themeMode in ['system', 'light', 'dark'])
        && (!('accentColor' in request.resource.data)
            || request.resource.data.accentColor is int)
        && (!('amoled' in request.resource.data)
            || request.resource.data.amoled is bool);

      // Dihapus saat pengguna menghapus akunnya (setelah semua datanya dihapus).
      allow delete: if isOwner(uid);

      // Kategori: tipe tidak boleh diubah setelah dibuat.
      match /categories/{id} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && validCategory(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if canUse(uid)
          && validCategory(request.resource.data)
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /transactions/{id} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && validTransaction(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if canUse(uid)
          && validTransaction(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /wallets/{id} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && validWallet(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if canUse(uid)
          && validWallet(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // Transaksi berulang, transfer antar dompet, target tabungan, utang & piutang.

      match /recurring/{id} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && validRecurring(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if canUse(uid)
          && validRecurring(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /transfers/{id} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && validTransfer(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if canUse(uid)
          && validTransfer(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /goals/{id} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && validGoal(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if canUse(uid)
          && validGoal(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /debts/{id} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && validDebt(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if canUse(uid)
          && validDebt(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // Id dokumen struk = id transaksinya.
      match /receipts/{id} {
        allow read, delete: if canUse(uid);
        allow create, update: if canUse(uid)
          && validReceipt(request.resource.data);
      }

      // Id dokumen anggaran: "<yyyy-MM>_<categoryId>" (satu per kategori per bulan).
      match /budgets/{id} {
        allow read, delete: if canUse(uid);
        allow create, update: if canUse(uid)
          && validBudget(request.resource.data)
          && id == request.resource.data.month + '_' + request.resource.data.categoryId;
      }
    }

    // Tolak semua yang tidak disebutkan di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
